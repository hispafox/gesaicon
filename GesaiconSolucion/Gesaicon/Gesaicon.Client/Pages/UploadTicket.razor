@page "/upload-ticket"

<h3>Subir Ticket de Gasto</h3>

<InputFile OnChange="UploadFile" />

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <p>@StatusMessage</p>
}

@code {
    private string? StatusMessage;

    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
        {
            StatusMessage = "Selecciona un archivo.";
            return;
        }

        using var content = new MultipartFormDataContent();
        var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB
        content.Add(new StreamContent(stream), "file", file.Name);

        var http = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        var response = await http.PostAsync("api/ExpenseTickets/upload", content);
        if (response.IsSuccessStatusCode)
        {
            StatusMessage = "Archivo subido correctamente.";
        }
        else
        {
            StatusMessage = "Error al subir el archivo.";
        }
    }

    [Inject] NavigationManager NavigationManager { get; set; } = default!;
}
