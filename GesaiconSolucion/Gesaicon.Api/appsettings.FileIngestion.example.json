{
  "FileIngestion": {
    "Enabled": true,
    "DefaultCompanySlug": "miempresa",  // <-- CAMBIA ESTO al slug de tu empresa
    "ForceReprocessAll": false,         // <-- CAMBIA A true para reprocesar TODOS los tickets
    "SourceFolder": "Incoming",
    "BackupFolder": "IncomingBackup",
    "ProcessedFolder": "IncomingProcessed",
    "ErrorFolder": "IncomingError",
    "ScanIntervalSeconds": 15,
    "StableAgeSeconds": 5,
    "MaxPerScan": 25,
    "EnqueueForAnalysis": true,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ]
  }
}
