@page "/files"
@using System.Net.Http.Json
@using Gesaicon.Web.Models
@inject HttpClient Http

<style>
    .status-badge {
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.875rem;
        font-weight: 500;
    }
    .status-completed { background-color: #d1e7dd; color: #0f5132; }
    .status-error { background-color: #f8d7da; color: #842029; }
    .status-processing { background-color: #fff3cd; color: #664d03; }
    .status-pending { background-color: #cfe2ff; color: #084298; }
    
    .btn-action {
        min-width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }

    /* Modal personalizado */
    .modal-xl-custom {
        max-width: 95%;
        width: 1400px;
    }

    .modal-body-scroll {
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .ticket-image {
        max-height: 600px;
        width: 100%;
        object-fit: contain;
        background-color: #f8f9fa;
        border-radius: 0.375rem;
    }
</style>

<h3 class="mb-4">
    Gestor de Archivos
    @if (_legacyCount > 0)
    {
        <span class="badge bg-warning text-dark ms-2" title="Archivos en estructura antigua que necesitan migración">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            @_legacyCount Legacy
        </span>
    }
    else if (_total > 0)
    {
        <span class="badge bg-success ms-2">
            <i class="bi bi-check-circle-fill me-1"></i>
            Todo migrado
        </span>
    }
</h3>

<div class="mb-3 d-flex gap-2 flex-wrap align-items-start">
    <input class="form-control" style="max-width:260px" placeholder="Buscar..."
           @bind="_search" @bind:event="oninput" />
    <select class="form-select" style="max-width:140px" @bind="_statusFilter">
        <option value="">(Estado)</option>
        <option>Processing</option>
        <option>Completed</option>
        <option>Error</option>
    </select>
    <select class="form-select" style="max-width:160px" @bind="_structureFilter" @bind:after="LoadAsync">
        <option value="">(Estructura)</option>
        <option value="legacy">?? Solo Legacy</option>
        <option value="new">? Solo Nueva</option>
    </select>
    <select class="form-select" style="max-width:120px" @bind="_pageSize">
        <option value="20">20</option>
        <option value="50" selected>50</option>
        <option value="100">100</option>
    </select>
    <button class="btn btn-primary" @onclick="LoadAsync" disabled="@_loading">
        @if(_loading) { <span class="spinner-border spinner-border-sm me-1"></span> }
        Recargar
    </button>
    @if (_legacyCount > 0 && string.IsNullOrEmpty(_structureFilter))
    {
        <button class="btn btn-warning" @onclick='() => { _structureFilter = "legacy"; LoadAsync(); }' title="Mostrar solo archivos legacy">
            <i class="bi bi-filter me-1"></i>
            Ver @_legacyCount Legacy
        </button>
    }
</div>

@if (_legacyCount > 0 && string.IsNullOrEmpty(_structureFilter))
{
    <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
        <div class="flex-grow-1">
            <strong>Archivos Legacy Detectados</strong>
            <p class="mb-0 small">
                Hay <strong>@_legacyCount archivos</strong> en estructura antigua que deberían migrarse.
                <button class="btn btn-sm btn-outline-warning ms-2" @onclick='() => { _structureFilter = "legacy"; LoadAsync(); }'>
                    <i class="bi bi-filter me-1"></i>
                    Mostrar solo legacy
                </button>
            </p>
        </div>
        <div class="text-end">
            <small class="text-muted d-block">Progreso de migración</small>
            <div class="progress" style="width: 200px; height: 8px;">
                <div class="progress-bar bg-success" role="progressbar" 
                     style="width: @((_total - _legacyCount) * 100.0 / _total)%"
                     aria-valuenow="@(_total - _legacyCount)" 
                     aria-valuemin="0" 
                     aria-valuemax="@_total">
                </div>
            </div>
            <small class="text-muted">@((_total - _legacyCount) * 100 / _total)% migrado</small>
        </div>
    </div>
}

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-3">Id</th>
                            <th>Archivo</th>
                            <th>Ruta / Estructura</th>
                            <th>Empresa</th>
                            <th>Categoría</th>
                            <th>Fecha Ticket</th>
                            <th class="text-end">Importe</th>
                            <th>Estado</th>
                            <th>Subido</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var t in _tickets)
                    {
                        <tr @onclick="(() => OpenModal(t))" style="cursor:pointer">
                            <td class="px-3">@t.Id</td>
                            <td>
                                <div class="d-flex flex-column">
                                    <span>@t.FileName</span>
                                    @if (t.IsLegacy)
                                    {
                                        <small class="text-danger">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                            <strong>Legacy</strong>
                                        </small>
                                    }
                                </div>
                            </td>
                            <td>
                                <small class="text-muted" style="font-family: monospace">
                                    @if (t.IsLegacy)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-folder2-open me-1"></i>
                                            Uploads/
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-folder-check me-1"></i>
                                            @t.ShortPath
                                        </span>
                                    }
                                </small>
                            </td>
                            <td>@t.CompanyName</td>
                            <td>@t.Category</td>
                            <td>
                                @if (t.PurchaseDate.HasValue)
                                {
                                    <span class="badge bg-primary">
                                        <i class="bi bi-calendar-check me-1"></i>
                                        @t.PurchaseDate.Value.ToString("yyyy-MM-dd")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        <i class="bi bi-calendar-x me-1"></i>
                                        Sin fecha
                                    </span>
                                }
                            </td>
                            <td class="text-end">@((t.Amount)?.ToString("0.00"))</td>
                            <td>
                                <span class="status-badge @GetStatusClass(t.Status)">
                                    @t.Status
                                </span>
                            </td>
                            <td>@t.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <div class="d-flex gap-1 justify-content-center">
                                    @if (!string.IsNullOrWhiteSpace(t.FileUrl))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary btn-action" href="@Absolute(t.FileUrl)" target="_blank" @onclick:stopPropagation title="Ver imagen">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (t.Status == "Completed" && !string.IsNullOrWhiteSpace(t.AnalysisFileUrl))
                                    {
                                        <button class="btn btn-sm btn-outline-info btn-action" title="Ver análisis" @onclick="(e => OpenModal(t))" @onclick:stopPropagation>
                                            <i class="bi bi-file-earmark-text"></i>
                                        </button>
                                    }
                                    @if (t.IsLegacy)
                                    {
                                        <button class="btn btn-sm btn-warning btn-action" title="Migrar a nueva estructura" disabled="@(_migratingIds.Contains(t.Id))" @onclick="(e=> MigrateTicket(t, e))" @onclick:stopPropagation>
                                            @if(_migratingIds.Contains(t.Id)) { 
                                                <span class="spinner-border spinner-border-sm"></span> 
                                            } else { 
                                                <i class="bi bi-arrow-right-circle"></i> 
                                            }
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-primary btn-action" title="Reprocesar" disabled="@(_reprocessingIds.Contains(t.Id))" @onclick="(e=> Reprocess(t, e, false))" @onclick:stopPropagation>
                                        @if(_reprocessingIds.Contains(t.Id)) { 
                                            <span class="spinner-border spinner-border-sm"></span> 
                                        } else { 
                                            <i class="bi bi-arrow-clockwise"></i> 
                                        }
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted">
            <strong>@_total</strong> tickets totales
            @if (_legacyCount > 0)
            {
                <span class="text-warning ms-2">
                    (<i class="bi bi-exclamation-triangle-fill me-1"></i>@_legacyCount legacy)
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(_structureFilter))
            {
                <span class="badge bg-info ms-2">
                    <i class="bi bi-funnel me-1"></i>
                    Filtrado: @(_structureFilter == "legacy" ? "Solo Legacy" : "Solo Nueva Estructura")
                </span>
            }
        </div>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(_page==0 ? "disabled" : "")">
                    <button class="page-link" @onclick="PrevPage" disabled="@(_page==0)">&laquo; Anterior</button>
                </li>
                <li class="page-item active">
                    <span class="page-link">@(_page+1)</span>
                </li>
                <li class="page-item @((_page+1)*_pageSize >= _total ? "disabled" : "")">
                    <button class="page-link" @onclick="NextPage" disabled="@((_page+1)*_pageSize >= _total)">Siguiente &raquo;</button>
                </li>
            </ul>
        </nav>
    </div>
}

<!-- Modal de Detalle -->
@if (_showModal && _selected != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" @onclick="CloseModal">
        <div class="modal-dialog modal-xl-custom" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-receipt me-2"></i>
                        Ticket #@_selected.Id - @_selected.FileName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal" aria-label="Close"></button>
                </div>
                <div class="modal-body modal-body-scroll">
                    <!-- Acciones rápidas -->
                    <div class="mb-3 d-flex gap-2 align-items-center flex-wrap">
                        <span class="status-badge @GetStatusClass(_selected.Status)">@_selected.Status</span>
                        
                        @if (_selected.IsLegacy)
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Archivo Legacy
                            </span>
                            <button class="btn btn-sm btn-warning" disabled="@_migratingIds.Contains(_selected.Id)" @onclick="(e=> MigrateTicket(_selected, e))">
                                @if(_migratingIds.Contains(_selected.Id)) { 
                                    <span class="spinner-border spinner-border-sm me-1"></span> 
                                } else { 
                                    <i class="bi bi-arrow-right-circle me-1"></i> 
                                }
                                Migrar a Nueva Estructura
                            </button>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6">
                                <i class="bi bi-check-circle-fill me-1"></i>
                                Nueva Estructura
                            </span>
                            
                            @if (_selected.CompanySlug == "default" && !string.IsNullOrWhiteSpace(_selected.CompanyName))
                            {
                                <button class="btn btn-sm btn-warning" disabled="@_fixingSlugIds.Contains(_selected.Id)" @onclick="(e=> FixCompanySlug(_selected, e))">
                                    @if(_fixingSlugIds.Contains(_selected.Id)) { 
                                        <span class="spinner-border spinner-border-sm me-1"></span> 
                                    } else { 
                                        <i class="bi bi-wrench me-1"></i> 
                                    }
                                    Corregir Empresa
                                </button>
                            }
                        }
                        
                        <button class="btn btn-sm btn-primary" disabled="@_reprocessingIds.Contains(_selected.Id)" @onclick="(e=> Reprocess(_selected, e, false))">
                            @if(_reprocessingIds.Contains(_selected.Id)) { 
                                <span class="spinner-border spinner-border-sm me-1"></span> 
                            } else { 
                                <i class="bi bi-arrow-clockwise me-1"></i> 
                            }
                            Reprocesar
                        </button>
                        @if(_selected.Status == "Processing")
                        {
                            <button class="btn btn-sm btn-danger" disabled="@_reprocessingIds.Contains(_selected.Id)" @onclick="(e=> Reprocess(_selected, e, true))" title="Forzar reproceso si está atascado">
                                @if(_reprocessingIds.Contains(_selected.Id)) { 
                                    <span class="spinner-border spinner-border-sm me-1"></span> 
                                } else { 
                                    <i class="bi bi-exclamation-triangle me-1"></i> 
                                }
                                Forzar
                            </button>
                        }
                        @if (!string.IsNullOrWhiteSpace(_selected.FileUrl))
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="@Absolute(_selected.FileUrl)" target="_blank">
                                <i class="bi bi-download me-1"></i>
                                Descargar Original
                            </a>
                        }
                    </div>

                    <div class="row">
                        <!-- Columna Izquierda: Información -->
                        <div class="col-lg-5">
                            <div class="card mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información General</h6>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-5 text-muted">PublicId</dt>
                                        <dd class="col-7"><code class="small">@_selected.PublicId</code></dd>
                                        
                                        <dt class="col-5 text-muted">Archivo</dt>
                                        <dd class="col-7">@_selected.FileName</dd>
                                        
                                        <dt class="col-5 text-muted">Estructura</dt>
                                        <dd class="col-7">
                                            @if (_selected.IsLegacy)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-folder2-open me-1"></i>
                                                    Legacy
                                                </span>
                                                <div class="mt-1">
                                                    <small class="text-muted" style="font-family: monospace">
                                                        Uploads/@_selected.FileName
                                                    </small>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-folder-check me-1"></i>
                                                    Nueva
                                                </span>
                                                <div class="mt-1">
                                                    <small class="text-muted" style="font-family: monospace">
                                                        @_selected.RelativePath
                                                    </small>
                                                </div>
                                            }
                                        </dd>
                                        
                                        @if (!_selected.IsLegacy)
                                        {
                                            <dt class="col-5 text-muted">Empresa</dt>
                                            <dd class="col-7"><code class="small">@_selected.CompanySlug</code></dd>
                                            
                                            <dt class="col-5 text-muted">Periodo</dt>
                                            <dd class="col-7">@_selected.ExpenseYear/@_selected.ExpenseMonth?.ToString("00")</dd>
                                        }
                                        
                                        <dt class="col-5 text-muted">Tamaño</dt>
                                        <dd class="col-7">@FormatFileSize(_selected.FileSizeBytes)</dd>
                                        
                                        <dt class="col-5 text-muted">Empresa</dt>
                                        <dd class="col-7"><strong>@_selected.CompanyName</strong></dd>
                                        
                                        <dt class="col-5 text-muted">Categoría</dt>
                                        <dd class="col-7"><span class="badge bg-secondary">@_selected.Category</span></dd>
                                        
                                        <dt class="col-5 text-muted">Fecha del Ticket</dt>
                                        <dd class="col-7">
                                            @if (_selected.PurchaseDate.HasValue)
                                            {
                                                <span class="badge bg-primary fs-6">
                                                    <i class="bi bi-calendar-check me-1"></i>
                                                    @_selected.PurchaseDate.Value.ToString("dd/MM/yyyy")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    <i class="bi bi-calendar-x me-1"></i>
                                                    No disponible
                                                </span>
                                            }
                                        </dd>
                                        
                                        <dt class="col-5 text-muted">Importe</dt>
                                        <dd class="col-7"><strong class="text-success fs-5">@_selected.Amount?.ToString("C")</strong></dd>
                                        
                                        <dt class="col-5 text-muted">Fecha de subida</dt>
                                        <dd class="col-7">@_selected.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</dd>
                                    </dl>
                                    
                                    @if(_selected.Status == "Error" && !string.IsNullOrWhiteSpace(_selected.LastErrorMessage))
                                    {
                                        <div class="alert alert-danger py-2 mb-0 mt-2">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            <strong>Error:</strong> @_selected.LastErrorMessage
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Análisis -->
                            @if (_selected.Status == "Completed" && !string.IsNullOrWhiteSpace(_selected.AnalysisFileUrl))
                            {
                                <div class="card">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Análisis del Ticket</h6>
                                    </div>
                                    <div class="card-body">
                                        @if (!string.IsNullOrEmpty(_analysisError))
                                        {
                                            <div class="alert alert-warning py-2 mb-0">
                                                <i class="bi bi-exclamation-circle me-1"></i>@_analysisError
                                            </div>
                                        }
                                        else if (_analysisLoading)
                                        {
                                            <div class="text-center py-3">
                                                <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                                                <span>Cargando análisis...</span>
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(_analysisHtml))
                                        {
                                            <div class="border rounded p-3 bg-light" style="max-height:400px; overflow-y:auto">
                                                @((MarkupString)_analysisHtml)
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Columna Derecha: Imagen -->
                        <div class="col-lg-7">
                            @if (!string.IsNullOrWhiteSpace(_selected.FileUrl))
                            {
                                <div class="card">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-image me-2"></i>Vista Previa</h6>
                                    </div>
                                    <div class="card-body p-2 text-center">
                                        <img src="@Absolute(_selected.FileUrl!)" class="ticket-image" alt="Ticket" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle me-2"></i>
                                    No hay imagen disponible para este ticket.
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">
                        <i class="bi bi-x-lg me-1"></i>Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="mt-4">
    <h4>Procesos en segundo plano</h4>
    <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshBackgroundStatus">Refrescar</button>
    <span class="ms-2 text-muted">@_bgLastRefreshed</span>
    <div class="mt-2">
        @if (_bgLoading)
        {
            <em>Cargando...</em>
        }
        else if (_bgStatuses?.Count == 0)
        {
            <em>Sin datos</em>
        }
        else if (_bgStatuses != null)
        {
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Servicio</th>
                        <th>Estado</th>
                        <th>Última Actualización (UTC)</th>
                        <th>Procesados</th>
                        <th>Errores</th>
                        <th>Activo</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in _bgStatuses)
                {
                    <tr class="@(s.Running ? "" : "table-secondary")">
                        <td>@s.ServiceName</td>
                        <td>@s.LastMessage</td>
                        <td>@s.LastUpdateUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@s.Processed</td>
                        <td class="@(s.Errors>0?"text-danger fw-bold":"")">@s.Errors</td>
                        <td>@(s.Running?"Sí":"No")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<ExpenseTicketDto> _tickets = new();
    private ExpenseTicketDto? _selected;
    private bool _showModal = false;
    private int _total;
    private int _legacyCount;
    private int _page = 0;
    private int _pageSize = 50;
    private string? _statusFilter;
    private string? _structureFilter;
    private string _search = "";
    private bool _loading;
    private string? _error;

    private bool _analysisLoading;
    private string? _analysisHtml;
    private string? _analysisError;

    private HashSet<int> _reprocessingIds = new();
    private HashSet<int> _migratingIds = new();
    private HashSet<int> _fixingSlugIds = new();

    private List<BgStatusDto>? _bgStatuses;
    private bool _bgLoading;
    private string? _bgLastRefreshed;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await RefreshBackgroundStatus();
    }

    private string GetStatusClass(string status) => status switch
    {
        "Completed" => "status-completed",
        "Error" => "status-error",
        "Processing" => "status-processing",
        _ => "status-pending"
    };

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task LoadAsync()
    {
        _error = null;
        _loading = true;
        StateHasChanged();
        try
        {
            var qs = $"api/tickets?skip={_page * _pageSize}&take={_pageSize}";
            if (!string.IsNullOrWhiteSpace(_statusFilter))
                qs += $"&status={Uri.EscapeDataString(_statusFilter)}";
            if (!string.IsNullOrWhiteSpace(_search))
                qs += $"&search={Uri.EscapeDataString(_search)}";

            var result = await Http.GetFromJsonAsync<PagedResult<ExpenseTicketDto>>(qs);
            var allTickets = result?.Items ?? new();
            _total = result?.Total ?? 0;
            
            // Calcular cuántos son legacy del total
            _legacyCount = allTickets.Count(t => t.IsLegacy);
            
            // Aplicar filtro de estructura en cliente
            if (!string.IsNullOrWhiteSpace(_structureFilter))
            {
                _tickets = _structureFilter switch
                {
                    "legacy" => allTickets.Where(t => t.IsLegacy).ToList(),
                    "new" => allTickets.Where(t => !t.IsLegacy).ToList(),
                    _ => allTickets
                };
            }
            else
            {
                _tickets = allTickets;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenModal(ExpenseTicketDto ticket)
    {
        _selected = ticket;
        _showModal = true;
        _analysisHtml = null;
        _analysisError = null;
        
        if (ticket.Status == "Completed" && !string.IsNullOrWhiteSpace(ticket.AnalysisFileUrl))
        {
            await FetchAnalysis(ticket);
        }
        else
        {
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        _showModal = false;
        _selected = null;
        _analysisHtml = null;
        _analysisError = null;
        StateHasChanged();
    }

    private async Task FetchAnalysis(ExpenseTicketDto ticket)
    {
        _analysisLoading = true;
        _analysisError = null;
        _analysisHtml = null;
        StateHasChanged();
        try
        {
            var md = await Http.GetStringAsync($"api/tickets/{ticket.Id}/analysis");
            _analysisHtml = SimpleMarkdown(md);
        }
        catch (HttpRequestException)
        {
            _analysisError = "No hay análisis disponible";
        }
        catch (Exception ex)
        {
            _analysisError = ex.Message;
        }
        finally
        {
            _analysisLoading = false;
            StateHasChanged();
        }
    }

    private async Task Reprocess(ExpenseTicketDto ticket, MouseEventArgs e, bool force)
    {
        if (_reprocessingIds.Contains(ticket.Id)) return;
        _reprocessingIds.Add(ticket.Id);
        try
        {
            var resp = await Http.PostAsync($"api/tickets/{ticket.Id}/reprocess?force={(force ? "true" : "false")}", null);
            if (resp.IsSuccessStatusCode)
            {
                var updated = await resp.Content.ReadFromJsonAsync<ExpenseTicketDto>();
                if (updated != null)
                {
                    var idx = _tickets.FindIndex(x => x.Id == ticket.Id);
                    if (idx >= 0) _tickets[idx] = updated;
                    if (_selected?.Id == ticket.Id) _selected = updated;
                }
            }
            else if ((int)resp.StatusCode == 409 && ticket.Status == "Processing" && !force)
            {
                _error = "Conflicto: ya se procesa. Use botón Forzar.";
            }
            else
            {
                _error = $"No se pudo reprocesar (HTTP {(int)resp.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _reprocessingIds.Remove(ticket.Id);
            StateHasChanged();
        }
    }

    private async Task MigrateTicket(ExpenseTicketDto ticket, MouseEventArgs e)
    {
        if (_migratingIds.Contains(ticket.Id)) return;
        _migratingIds.Add(ticket.Id);
        try
        {
            // Reprocesar con migrateIfLegacy=true (es el default)
            var resp = await Http.PostAsync($"api/tickets/{ticket.Id}/reprocess?migrateIfLegacy=true", null);
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                var updated = System.Text.Json.JsonDocument.Parse(body);
                
                // Verificar si se migró
                var wasMigrated = updated.RootElement.TryGetProperty("migrated", out var migProp) && migProp.GetBoolean();
                
                // Obtener ticket actualizado
                ExpenseTicketDto? updatedTicket = null;
                if (updated.RootElement.TryGetProperty("ticket", out var ticketProp))
                {
                    updatedTicket = System.Text.Json.JsonSerializer.Deserialize<ExpenseTicketDto>(ticketProp.GetRawText());
                }
                else
                {
                    updatedTicket = System.Text.Json.JsonSerializer.Deserialize<ExpenseTicketDto>(body);
                }
                
                if (updatedTicket != null)
                {
                    var idx = _tickets.FindIndex(x => x.Id == ticket.Id);
                    if (idx >= 0) _tickets[idx] = updatedTicket;
                    if (_selected?.Id == ticket.Id) _selected = updatedTicket;
                    
                    if (wasMigrated)
                    {
                        _error = null;
                        // Cerrar el modal si se migró exitosamente
                        CloseModal();
                        // Recargar la lista para actualizar el contador de legacy
                        await LoadAsync();
                    }
                }
            }
            else
            {
                _error = $"No se pudo migrar (HTTP {(int)resp.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error al migrar: {ex.Message}";
        }
        finally
        {
            _migratingIds.Remove(ticket.Id);
            StateHasChanged();
        }
    }

    private async Task FixCompanySlug(ExpenseTicketDto ticket, MouseEventArgs e)
    {
        if (_fixingSlugIds.Contains(ticket.Id)) return;
        _fixingSlugIds.Add(ticket.Id);
        try
        {
            var resp = await Http.PostAsync($"api/tickets/{ticket.Id}/fix-company-slug", null);
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                var result = System.Text.Json.JsonDocument.Parse(body);
                
                // Obtener ticket actualizado
                ExpenseTicketDto? updatedTicket = null;
                if (result.RootElement.TryGetProperty("ticket", out var ticketProp))
                {
                    updatedTicket = System.Text.Json.JsonSerializer.Deserialize<ExpenseTicketDto>(ticketProp.GetRawText());
                }
                
                if (updatedTicket != null)
                {
                    var idx = _tickets.FindIndex(x => x.Id == ticket.Id);
                    if (idx >= 0) _tickets[idx] = updatedTicket;
                    if (_selected?.Id == ticket.Id) _selected = updatedTicket;
                    
                    // Mostrar mensaje de éxito
                    _error = null;
                }
            }
            else
            {
                var errorBody = await resp.Content.ReadAsStringAsync();
                _error = $"No se pudo corregir empresa: {errorBody}";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error al corregir empresa: {ex.Message}";
        }
        finally
        {
            _fixingSlugIds.Remove(ticket.Id);
            StateHasChanged();
        }
    }

    private async Task NextPage()
    {
        if (((_page + 1) * _pageSize) >= _total) return;
        _page++;
        await LoadAsync();
    }

    private async Task PrevPage()
    {
        if (_page == 0) return;
        _page--;
        await LoadAsync();
    }

    private string Absolute(string rel)
    {
        if (string.IsNullOrWhiteSpace(rel)) return "#";
        var baseUri = Http.BaseAddress?.ToString() ?? "/";
        return rel.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? rel : baseUri.TrimEnd('/') + rel;
    }

    private string SimpleMarkdown(string md)
    {
        if (string.IsNullOrWhiteSpace(md)) return string.Empty;
        var html = md;
        html = System.Net.WebUtility.HtmlEncode(html);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^###### (.*)$", "<h6>$1</h6>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^##### (.*)$", "<h5>$1</h5>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^#### (.*)$", "<h4>$1</h4>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^### (.*)$", "<h3>$1</h3>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^## (.*)$", "<h2>$1</h2>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"# (.*)$", "<h1>$1</h1>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");
        html = html.Replace("\r", "");
        html = string.Join("", html.Split('\n').Select(l => l.StartsWith("<h") ? l : ($"<p>{l}</p>")));
        return html;
    }

    private async Task RefreshBackgroundStatus()
    {
        try
        {
            _bgLoading = true; 
            StateHasChanged();
            var data = await Http.GetFromJsonAsync<List<BgStatusDto>>("api/diagnostics/background-status");
            _bgStatuses = data ?? new();
            _bgLastRefreshed = DateTime.UtcNow.ToString("HH:mm:ss");
        }
        catch (Exception ex)
        {
            _bgStatuses = new List<BgStatusDto>{ new BgStatusDto{ ServiceName="ERROR", LastMessage=ex.Message, Running=false } };
        }
        finally
        {
            _bgLoading = false; 
            StateHasChanged();
        }
    }

    public class BgStatusDto
    {
        public string ServiceName { get; set; } = string.Empty;
        public string LastMessage { get; set; } = string.Empty;
        public DateTime LastUpdateUtc { get; set; }
        public int Processed { get; set; }
        public int Errors { get; set; }
        public bool Running { get; set; }
    }
